# PostgreSQL
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME

# SENTINEL CORE
SENTINEL_ENV=production
SENTINEL_ENROLLMENT_TOKEN=user-id:CHANGE_ME_HIGH_ENTROPY_SECRET
SENTINEL_REQUIRE_ENROLLMENT=true
DATABASE_URL=postgresql+psycopg://sentinel:CHANGE_ME@postgres:5432/sentinel
SESSION_TTL_SECONDS=3600
REFRESH_TTL_SECONDS=2592000
MAX_REQUEST_SKEW_SECONDS=120
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=https://sentinel.example.com

# Optional federated authentication. Disabled unless explicitly enabled.
# Public IDs may be configured here; real client secrets remain deployment secrets.
# SENTINEL_GOOGLE_AUTH_ENABLED=false
# SENTINEL_GOOGLE_WEB_CLIENT_ID=<google-web-oauth-client-id>
# SENTINEL_TELEGRAM_AUTH_ENABLED=false
# SENTINEL_TELEGRAM_CLIENT_ID=<botfather-oidc-client-id>
# SENTINEL_TELEGRAM_CLIENT_SECRET=CHANGE_ME_OWNER_MANAGED_SECRET
# SENTINEL_TELEGRAM_REDIRECT_URIS=com.alpha0.app.auth.dev://callback,com.alpha0.app.physicaltest.auth://callback,com.alpha0.app.auth://callback
# SENTINEL_VK_AUTH_ENABLED=false
# SENTINEL_VK_CLIENT_ID=<vk-id-application-id>
# SENTINEL_VK_REDIRECT_URIS=vk<VK_CLIENT_ID>://vk.ru/blank.html

# Optional provider-neutral Companion voice adapter.
# Non-loopback endpoints must use HTTPS. Production credentials remain Owner-gated.
# SENTINEL_VOICE_PROVIDER_URL=https://voice-provider.example.com
# SENTINEL_VOICE_PROVIDER_TOKEN=CHANGE_ME_PROVIDER_SECRET
# SENTINEL_VOICE_PROVIDER_TIMEOUT_SECONDS=10

# Optional remote deployment secrets are configured in GitHub Actions Secrets,
# never in this file: DEPLOY_HOST, DEPLOY_USER, DEPLOY_KEY.
