# Sentinel server runtime configuration. Never commit real credentials.
SENTINEL_BIND_HOST=127.0.0.1
SENTINEL_PORT=8080
SENTINEL_DB_URL=jdbc:postgresql://db.example.internal:5432/sentinel
SENTINEL_DB_USER=sentinel
SENTINEL_DB_PASSWORD=REPLACE_ME
SENTINEL_ENROLLMENT_TOKEN=REPLACE_WITH_HIGH_ENTROPY_BOOTSTRAP_SECRET
# Comma-separated server-side subjects allowed to access the sample protected endpoint.
SENTINEL_OPERATOR_SUBJECTS=
